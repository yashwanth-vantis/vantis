---
import { ClientRouter } from "astro:transitions";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { site, canonical, link } from "../content/site";
import archivoUrl from "../assets/fonts/archivo-latin-var.woff2?url";
import hankenUrl from "../assets/fonts/hanken-grotesk-latin-var.woff2?url";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  path: string;
  noindex?: boolean;
}
const { title, description, path, noindex = false } = Astro.props;
const url = canonical(path);
const ogImage = `${site.origin}/og.png`;
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  name: site.name,
  url: site.origin,
});
---
<!doctype html>
<html lang="en-GB" dir="ltr" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    {(noindex || import.meta.env.PUBLIC_NOINDEX === "true") && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content={site.themeColor} />
    <meta name="color-scheme" content="dark" />

    <link rel="preload" href={archivoUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={hankenUrl} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href={link("/favicon.svg")} type="image/svg+xml" />
    <link rel="icon" href={link("/favicon-32.png")} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={link("/apple-touch-icon.png")} />
    <link rel="manifest" href={link("/site.webmanifest")} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Panright Studios. Know the film before the shoot." />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Panright Studios. Know the film before the shoot." />

    <script type="application/ld+json" set:html={jsonLd} />

    <!-- Motion gate: hide reveal targets only when motion is allowed and JS runs.
         Safety net: if the motion bundle has not started within 3s, show everything. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        if (window.matchMedia("(prefers-reduced-motion: no-preference)").matches) {
          d.classList.add("motion-ok");
          setTimeout(function () { if (!window.__panrightMotion) d.classList.remove("motion-ok"); }, 3000);
        }
      })();
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip-link" href="#main" transition:persist="skip-link">Skip to content</a>
    <Nav />
    <main id="main" tabindex="-1" data-main>
      <slot />
    </main>
    <Footer />
    <div class="pan-line" aria-hidden="true" data-pan-line transition:persist="pan-line"></div>
    <script>
      import "../scripts/app";
    </script>
  </body>
</html>
