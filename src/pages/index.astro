---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Statement from "../components/Statement.astro";
import Method from "../components/Method.astro";
import PhaseGrid from "../components/PhaseGrid.astro";
import CtaBand from "../components/CtaBand.astro";
import { seo, home } from "../content/site";
---
<Base title={seo.home.title} description={seo.home.description} path="/">
  <Hero />
  <Statement id="premise" label={home.premise.label} headline={home.premise.headline} copy={home.premise.copy} />
  <Method />
  <PhaseGrid />
  <Statement id="principle" variant="principle" headline={home.principle.headline} copy={home.principle.copy} />
  <CtaBand />
</Base>
