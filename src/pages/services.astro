---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import PhaseSection from "../components/PhaseSection.astro";
import CtaBand from "../components/CtaBand.astro";
import { seo, services, phases } from "../content/site";
---
<Base title={seo.services.title} description={seo.services.description}>
  <div class="prb">
  <PageHeader headline={services.header.headline} lead={services.header.lead}>
    <nav class="anchors" aria-label="Phases" data-reveal>
      <ul role="list">
        {phases.map((p, i) => (
          <li>
            {i > 0 && <span class="t-label anchors__sep" aria-hidden="true">/</span>}
            <a class="link-draw t-label anchors__link" href={`#${p.id}`}><span>{p.index} {p.name}</span></a>
          </li>
        ))}
      </ul>
    </nav>
  </PageHeader>
  {phases.map((p, i) => <PhaseSection phase={p} tone={i % 2 === 0 ? "surface" : "bg"} />)}
  <CtaBand />
  </div>
</Base>
<style>
  .anchors { margin-top: var(--space-7); }
  .anchors ul { display: flex; flex-wrap: wrap; align-items: center; column-gap: var(--space-3); }
  .anchors li { display: flex; align-items: center; gap: var(--space-3); }
  .anchors__link { color: var(--color-text-muted); font-weight: var(--weight-label); }
  .anchors__link:hover { color: var(--color-text-primary); }
</style>
