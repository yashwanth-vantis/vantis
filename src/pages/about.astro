---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import Statement from "../components/Statement.astro";
import PrincipleGrid from "../components/PrincipleGrid.astro";
import CompanyNote from "../components/CompanyNote.astro";
import CtaBand from "../components/CtaBand.astro";
import { seo, about } from "../content/site";
---
<Base title={seo.about.title} description={seo.about.description}>
  <div class="prb">
  <PageHeader headline={about.header.headline} lead={about.header.lead} />
  <Statement id="belief" label={about.belief.label} headline={about.belief.headline} copy={about.belief.copy} />
  <PrincipleGrid />
  <CompanyNote />
  <CtaBand />
  </div>
</Base>
