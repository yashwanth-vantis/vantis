---
/** <PageHeader>: h1 cols 1–9, lead cols 1–6, --space-9 top (below the nav). Optional slot for the anchor row. */
import { noWidow } from "../content/site";
interface Props { headline: string; lead: string; label?: string }
const { headline, lead, label } = Astro.props;
---
<section class="page-header bg" aria-labelledby="page-title">
  <div class="container grid">
    <div class="page-header__title stack-heading" data-reveal>
      {label && <p class="t-label">{label}</p>}
      <h1 id="page-title" class="t-h1">{noWidow(headline)}</h1>
    </div>
    <p class="t-lead page-header__lead" data-reveal>{lead}</p>
    <slot />
  </div>
</section>
<style>
  .page-header { padding-top: calc(var(--nav-h) + var(--space-9)); padding-bottom: var(--section-y-tight); }
  .page-header__lead { margin-top: var(--stack-heading); }
  @media (min-width: 64rem) {
    .page-header__title { grid-column: 1 / span 9; }
    .page-header__lead { grid-column: 1 / span 6; }
  }
</style>
