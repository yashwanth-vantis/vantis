---
/** <PrincipleGrid>: three raised cards, four columns each. */
import { about } from "../content/site";
---
<section class="section surface" aria-labelledby="principles-title">
  <div class="container">
    <h2 id="principles-title" class="visually-hidden">{about.principlesHeading}</h2>
    <ul role="list" class="grid principles" data-reveal-group>
      {about.principles.map((p) => (
        <li class="card principle">
          <h3 class="t-h4">{p.title}</h3>
          <p class="t-body t-muted">{p.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .principles { row-gap: var(--grid-gutter); }
  .principle > * + * { margin-top: var(--space-3); }
  @media (min-width: 40rem) { .principle { grid-column: span 8; } }
  @media (min-width: 64rem) { .principle { grid-column: span 4; } }
</style>
