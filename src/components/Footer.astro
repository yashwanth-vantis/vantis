---
import Logo from "./Logo.astro";
import { nav, footer, site, link } from "../content/site";
---
<footer class="footer surface" data-site-footer transition:persist="site-footer">
  <div class="container">
    <div class="grid footer__top">
      <div class="footer__brand">
        <a href={link("/")} class="footer__home" aria-label="Panright Studios, home" data-nav-link><Logo /></a>
        <p class="t-muted">{footer.tagline}</p>
      </div>
      <nav class="footer__nav" aria-label="Footer">
        <ul role="list">
          {nav.map((item) => (
            <li><a href={link(item.href)} class="link-draw footer__link" data-nav-link><span>{item.label}</span></a></li>
          ))}
        </ul>
      </nav>
      <div class="footer__contact">
        <p class="footer__email">{site.contactEmail}</p>
      </div>
    </div>
    <div class="footer__base">
      <p class="t-small t-muted">
        © {site.year} {site.legalEntity} <span aria-hidden="true">·</span>
        <a href={link("/privacy/")} class="link-inline" data-nav-link>Privacy</a>
      </p>
      <p class="t-label">{footer.endLabel}</p>
    </div>
  </div>
</footer>

<style>
  .footer { padding-block: var(--space-8) var(--space-5); }
  .footer__top { row-gap: var(--space-6); }
  .footer__brand > * + * { margin-top: var(--space-4); }
  .footer__home { display: inline-flex; align-items: center; min-height: var(--tap); color: var(--color-text-primary); }
  .footer__link { font-size: var(--text-body); font-weight: var(--weight-body); color: var(--color-text-muted); }
  .footer__link:hover { color: var(--color-text-primary); }
  .footer__email { min-height: var(--tap); display: flex; align-items: center; color: var(--color-text-primary); }
  .footer__base {
    margin-top: var(--space-8);
    padding-top: var(--space-4);
    border-top: var(--border-hair);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3) var(--space-5);
  }
  .footer__base .link-inline { display: inline-block; padding-block: 0.875rem; margin-block: -0.875rem; }
  @media (min-width: 40rem) {
    .footer__brand { grid-column: 1 / span 4; }
    .footer__nav { grid-column: 5 / span 2; }
    .footer__contact { grid-column: 7 / span 2; }
  }
  @media (min-width: 64rem) {
    .footer__brand { grid-column: 1 / span 5; }
    .footer__nav { grid-column: 7 / span 3; }
    .footer__contact { grid-column: 10 / span 3; }
  }
</style>
