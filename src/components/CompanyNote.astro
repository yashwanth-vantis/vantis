---
/** <CompanyNote>: text cols 1–6; mono fact rows cols 8–12. */
import { about } from "../content/site";
const c = about.company;
---
<section class="section bg" aria-labelledby="company-title">
  <div class="container grid company" data-reveal>
    <h2 id="company-title" class="visually-hidden">{c.heading}</h2>
    <div class="company__text stack-heading">
      <p class="t-h3">{c.status}</p>
      <p class="t-body t-muted">{c.story}</p>
    </div>
    <dl class="company__facts">
      {c.rows.map((r) => (
        <div class="company__fact">
          <dt class="t-label">{r.label}</dt>
          <dd class="t-label company__value">{r.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
<style>
  .company { row-gap: var(--space-6); }
  .company__facts { border-bottom: var(--border-hair); }
  .company__fact {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
    gap: var(--grid-gutter);
    padding-block: var(--space-3);
    border-top: var(--border-hair);
  }
  .company__value { color: var(--color-text-muted); margin: 0; }
  @media (min-width: 40rem) {
    .company__text { grid-column: 1 / span 5; }
    .company__facts { grid-column: 1 / span 6; }
  }
  @media (min-width: 64rem) {
    .company__text { grid-column: 1 / span 6; }
    .company__facts { grid-column: 8 / span 5; }
  }
</style>
