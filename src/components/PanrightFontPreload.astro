---
/**
 * Preloads only the woff2 files the first paint needs (Archivo, Hanken Grotesk 400, latin).
 * Same files the Fontsource CSS references, so Vite emits one hashed asset for each.
 */
import archivoWoff2 from "@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url";
import hankenWoff2 from "@fontsource/hanken-grotesk/files/hanken-grotesk-latin-400-normal.woff2?url";
---
<link rel="preload" href={archivoWoff2} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={hankenWoff2} as="font" type="font/woff2" crossorigin />
