---
/**
 * <MediaFrame> — NOT USED AT LAUNCH. For stills added later (see README).
 * 2.39:1, zero radius, hover-pan per tokens (translateX(-var(--hover-pan)), --duration-pan, --ease-pan).
 * Stills must be graded to #59626B or darker if glass ever sits on them (usage-rules.md §3).
 */
interface Props { src: string; alt: string; width: number; height: number; caption?: string }
const { src, alt, width, height, caption } = Astro.props;
---
<figure class="media-frame">
  <div class="media-frame__viewport">
    <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
  </div>
  {caption && <figcaption class="t-label">{caption}</figcaption>}
</figure>
<style>
  .media-frame { margin: 0; }
  .media-frame__viewport { aspect-ratio: 2.39; overflow: hidden; border-radius: var(--radius-0); background: var(--color-surface); }
  .media-frame img {
    width: 103%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    transition: transform var(--duration-pan) var(--ease-pan);
  }
  @media (hover: hover) {
    .media-frame:hover img { transform: translateX(calc(var(--hover-pan) * -1)); }
  }
  figcaption { margin-top: var(--space-2); }
</style>
