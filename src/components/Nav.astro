---
import Logo from "./Logo.astro";
import { nav, link } from "../content/site";
const path = Astro.url.pathname;
---
<header class="site-header" data-site-header transition:persist="site-header">
  <div class="bar glass-nav">
    <div class="container bar__inner">
      <a href={link("/")} class="bar__home" aria-label="Panright Studios, home" data-nav-link>
        <Logo />
      </a>
      <nav aria-label="Primary" class="bar__nav">
        <ul role="list" class="bar__links">
          {nav.map((item) => (
            <li>
              <a href={link(item.href)} class="link-draw nav-link" data-nav-link aria-current={path.startsWith(link(item.href)) ? "page" : undefined}>
                <span>{item.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <button type="button" class="link-draw nav-link bar__menu" aria-expanded="false" aria-controls="menu-panel" data-menu-toggle>
        <span data-menu-label>Menu</span>
      </button>
    </div>
  </div>
  <div id="menu-panel" class="menu" data-menu-panel hidden>
    <nav aria-label="Primary, mobile" class="container">
      <ul role="list" class="menu__links">
        {nav.map((item) => (
          <li>
            <a href={link(item.href)} class="link-draw menu__link" data-nav-link aria-current={path.startsWith(link(item.href)) ? "page" : undefined}>
              <span>{item.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--nav-h);
    margin-bottom: calc(var(--nav-h) * -1); /* content runs under the glass bar */
  }
  .bar { height: var(--nav-h); }
  .bar__inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
  }
  .bar__home {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: var(--color-text-primary);
  }
  .bar__links { display: flex; gap: var(--space-5); }
  .nav-link {
    font-family: var(--font-body);
    font-size: var(--text-small);
    font-weight: var(--weight-strong);
    letter-spacing: var(--tracking-small);
    color: var(--color-text-muted);
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
  }
  .nav-link:hover, .nav-link[aria-current="page"] { color: var(--color-text-primary); }
  .bar__menu { display: none; min-width: var(--tap); justify-content: flex-end; }

  .menu {
    position: fixed;
    inset: var(--nav-h) 0 0 0;
    background: var(--color-bg);
    padding-block: var(--space-6);
    overflow-y: auto;
  }
  .menu__links { display: grid; gap: var(--space-3); }
  .menu__link {
    font-family: var(--font-headline);
    font-size: var(--text-h2);
    line-height: var(--leading-h2);
    font-weight: var(--weight-heading);
    color: var(--color-text-muted);
  }
  .menu__link[aria-current="page"] { color: var(--color-text-primary); }

  @media (max-width: 39.99rem) {
    .bar__nav { display: none; }
    .bar__menu { display: inline-flex; }
  }
  @media (min-width: 40rem) {
    .menu { display: none !important; }
  }
</style>
