---
/** <Method>: header cols 1–4; four hairline rows cols 6–12 (mono index + one sentence). */
import { home, noWidow } from "../content/site";
const m = home.method;
---
<section class="section bg" aria-labelledby="method-title">
  <div class="container grid method">
    <div class="method__head" data-reveal>
      <h2 id="method-title" class="t-h2">{noWidow(m.headline)}</h2>
    </div>
    <div class="method__body">
      <ol role="list" class="rows method__rows" data-reveal-group>
        {m.rows.map((row, i) => (
          <li class="method__row">
            <span class="t-label" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <p class="t-body">{row}</p>
          </li>
        ))}
      </ol>
      <p class="t-small t-muted method__note" data-reveal>{m.note}</p>
    </div>
  </div>
</section>
<style>
  .method { row-gap: var(--space-6); }
  .method__row {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    align-items: baseline;
    gap: var(--space-3);
    padding-block: var(--space-4);
  }
  .method__note { margin-top: var(--space-4); }
  @media (min-width: 40rem) {
    .method__head { grid-column: 1 / span 3; }
    .method__body { grid-column: 4 / span 5; }
  }
  @media (min-width: 64rem) {
    .method__head { grid-column: 1 / span 4; }
    .method__body { grid-column: 6 / span 7; }
  }
</style>
