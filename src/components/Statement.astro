---
/** <Statement>: label cols 1–3 + text cols 4–11, or (variant="principle") text cols 3–10 with --space-9 above and below. */
import { noWidow } from "../content/site";
interface Props { label?: string; headline: string; copy: string; variant?: "label" | "principle"; id?: string }
const { label, headline, copy, variant = "label", id } = Astro.props;
const hid = `${id ?? headline.toLowerCase().replace(/[^a-z]+/g, "-").slice(0, 24)}-title`;
---
<section class:list={["statement bg", variant === "principle" ? "statement--principle" : "section"]} aria-labelledby={hid}>
  <div class="container grid" data-reveal>
    {label && <p class="t-label statement__label">{label}</p>}
    <div class="statement__text stack-heading">
      <h2 id={hid} class="t-h2">{noWidow(headline)}</h2>
      <p class="t-body t-muted">{copy}</p>
    </div>
  </div>
</section>
<style>
  .statement--principle { padding-block: var(--space-9); }
  .statement__label { padding-top: 0.6em; margin-bottom: var(--space-4); }
  @media (min-width: 40rem) {
    .statement__label { grid-column: 1 / span 2; margin-bottom: 0; }
    .statement__text { grid-column: 3 / span 6; }
    .statement--principle .statement__text { grid-column: 2 / span 6; }
  }
  @media (min-width: 64rem) {
    .statement__label { grid-column: 1 / span 3; }
    .statement__text { grid-column: 4 / span 8; }
    .statement--principle .statement__text { grid-column: 3 / span 8; }
  }
</style>
