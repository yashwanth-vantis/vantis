---
/**
 * <Hero> + <HeroBackdrop>. page-spec.md Home §1.
 * The 2.39:1 frame holds its ratio at every width ≥ 1024px. On short viewports the
 * whole stage (frame, lead, buttons, card) narrows so the primary CTA stays above
 * the fold; the frame never changes ratio. See DECISIONS.md D-01.
 */
import { home, noWidow, link } from "../content/site";
const h = home.hero;
---
<section class="hero" data-hero aria-labelledby="hero-title">
  <div class="hero__light" data-hero-light aria-hidden="true"></div>
  <div class="hero__grain" aria-hidden="true"></div>

  <div class="container">
    <div class="hero__stage">
      <div class="hero__box" data-hero-frame-mobile>
        <div class="hero__frame" data-hero-frame-desktop>
          <p class="t-label hero__slate hero__slate--tl" aria-hidden="true" data-hero-item>{h.slate.scene}</p>
          <p class="t-label hero__slate hero__slate--tr" aria-hidden="true" data-hero-item>{h.slate.ratio}</p>
          <p class="t-label hero__slate hero__slate--bl" aria-hidden="true" data-hero-item>{h.slate.timecode}</p>
          <p class="t-label hero__slate hero__slate--studio" aria-hidden="true" data-hero-item>{h.slate.studio}</p>
          <h1 id="hero-title" class="t-display hero__title" data-hero-item>{noWidow(h.headline)}</h1>
        </div>

        <div class="hero__copy">
          <p class="t-lead hero__lead" data-hero-item>{h.lead}</p>
          <div class="hero__actions" data-hero-item>
            <a class="btn-accent" href={link(h.primary.href)} data-hero-cta><span>{h.primary.label}</span></a>
            <a class="link-draw" href={link(h.secondary.href)}><span>{h.secondary.label}</span></a>
          </div>
        </div>
      </div>

      <div class="hero__card glass-card" data-hero-item>
        <p class="hero__card-label">{h.card.label}</p>
        <p class="hero__card-text">{h.card.text}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: 100svh;
    padding-top: var(--nav-h);
    padding-bottom: var(--space-6);
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: var(--color-bg);
  }

  /* HeroBackdrop: light (bottom), grain. Light rests at its end position; GSAP
     plays the single pass from 0 when motion is allowed. */
  .hero__light {
    position: absolute;
    inset: 0;
    z-index: -2;
    background: radial-gradient(30vw 25vh at 20% 50%, rgb(167 179 192 / 0.10), transparent);
    transform: translateX(40vw);
    pointer-events: none;
  }
  .hero__grain {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: var(--glass-noise);
    pointer-events: none;
  }

  .hero__title {
    color: var(--color-text-primary);
    max-width: 100%;
  }
  .hero__slate { position: absolute; margin: 0; white-space: nowrap; }
  .hero__slate--tl { top: var(--space-3); left: 0; }
  .hero__slate--tr { top: var(--space-3); right: 0; display: none; }
  .hero__slate--bl { bottom: var(--space-3); left: 0; }
  .hero__slate--studio { bottom: var(--space-3); right: 0; }

  .hero__copy > * + * { margin-top: var(--stack-heading); }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-5);
  }

  .hero__card { padding: var(--space-4); }
  .hero__card-label {
    font-family: var(--font-label);
    font-size: var(--text-label);
    line-height: var(--leading-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .hero__card-text {
    margin-top: var(--space-2);
    font-family: var(--font-body);
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--color-text-primary);
  }

  /* ------------------------------------------------ < 1024: frame grows */
  @media (max-width: 63.99rem) {
    .hero__box {
      position: relative;
      min-height: fit-content;
      padding-block: var(--space-7);
      border-block: var(--border-strong);
    }
    .hero__copy { margin-top: var(--space-5); }
    .hero__card { margin-top: var(--space-5); }
  }
  @media (min-width: 40rem) and (max-width: 63.99rem) {
    .hero__box { padding-inline: var(--space-7); border-inline: var(--border-strong); }
    .hero__slate--tl, .hero__slate--bl { left: var(--space-3); }
    .hero__slate--studio { right: var(--space-3); }
  }

  /* ------------------------------------------------ ≥ 1024: 2.39:1 frame */
  @media (min-width: 64rem) {
    .hero {
      /* Height everything below the frame needs: nav, gap, two lead lines,
         gap, buttons, bottom breathing room. Used to cap the stage width. */
      --hero-reserve: calc(
        var(--nav-h) + var(--space-4) + var(--space-5) + 2 * var(--text-lead) * var(--leading-lead) +
        var(--stack-heading) + var(--tap) + var(--space-4)
      );
      padding-top: calc(var(--nav-h) + var(--space-4));
      padding-bottom: var(--space-4);
    }
    .hero__stage {
      container-type: inline-size;
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--grid-gutter);
      /* D-01: on short viewports the stage narrows so frame + lead + CTA fit;
         the frame keeps 2.39:1. Floor of 40rem keeps the headline legible. */
      max-width: max(40rem, min(100%, calc((100svh - var(--hero-reserve)) * 2.39)));
      margin-inline: auto; /* a narrowed stage is letterboxed in the centre, like a projected frame */
    }
    .hero__box { display: contents; }
    .hero__frame {
      --hcol: calc((100cqi - 11 * var(--grid-gutter)) / 12);
      grid-column: 1 / -1;
      grid-row: 1;
      position: relative;
      aspect-ratio: 2.39;
      height: auto;
      border: var(--border-strong);
      padding: var(--space-7);
      display: flex;
      align-items: flex-end;
    }
    .hero__title {
      /* cols 1–11 inside the --space-7 inset */
      max-width: calc(100cqi - var(--hcol) - var(--grid-gutter) - var(--space-7));
      /* Never larger than the token; never taller than three lines in the frame;
         never wider than cols 1–11 (k = 8.2em: widest line of the 3-line wrap). */
      font-size: min(
        var(--text-display),
        calc(14.5cqi - 45px),
        calc((100cqi - var(--hcol) - var(--grid-gutter) - var(--space-7)) / 8.2)
      );
    }
    .hero__slate--tl { left: var(--space-3); }
    .hero__slate--tr { right: var(--space-3); display: block; }
    .hero__slate--bl { left: var(--space-3); }
    .hero__slate--studio { right: calc(4 * var(--hcol) + 4 * var(--grid-gutter)); }

    .hero__copy {
      grid-column: 1 / span 6;
      grid-row: 2;
      padding-top: var(--space-5);
    }
    .hero__card {
      grid-column: 9 / span 4;
      grid-row: 2;
      align-self: start;
      margin-top: calc(var(--space-5) * -1); /* straddles the frame's bottom line */
      position: relative;
      z-index: 1;
    }
  }
</style>
