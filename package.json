{
  "name": "panright-studios",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "fonts": "python3 -I scripts/build-fonts.py",
    "assets": "node scripts/generate-assets.mjs",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "build": "npm run check:placeholders && astro build && node scripts/postbuild.mjs",
    "build:preview": "astro build && node scripts/postbuild.mjs",
    "preview": "astro preview --port 4321",
    "test": "node scripts/test/run-all.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "astro": "^7.4.12",
    "gsap": "^3.15.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "lighthouse": "^13.6.0",
    "opentype.js": "^2.0.0",
    "sharp": "^0.35.5"
  }
}
